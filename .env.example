# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:REPLACE_ME

# Путь к файлу SQLite внутри контейнера/рабочей директории
DATABASE_PATH=data/price_radar.db

# Порог уведомления, % от Цены сравнения
THRESHOLD_PCT=0.5

# Лимит активных Отслеживаний на пользователя
MAX_ACTIVE_TRACKINGS=100

# Окно непрерывной недоступности товара (часы) до одиночного уведомления
UNAVAILABLE_WINDOW_HOURS=48

# Диапазон случайного сна Цикла проверки (минуты), max > min
CYCLE_MIN_SLEEP_MINUTES=45
CYCLE_MAX_SLEEP_MINUTES=75

# Регион (dest) по умолчанию — ключ справочника REGIONS
DEFAULT_DEST=Курск

# Справочник Регионов: JSON-словарь "имя города" -> dest-ID.
# dest-ID публично недоступны, собираются вручную из браузера с резидентным IP
# (см. docs/research/wb-regions.md §2). Значение -1000000 ниже — placeholder.
REGIONS={"Курск": "-1000000"}
